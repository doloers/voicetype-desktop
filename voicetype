# ───────────────────────── 录音 ─────────────────────────
def recorder_cmd(cfg):
    cmd = ["parec", "--format=s16le",
           "--rate=%d" % cfg["rate"],
           "--channels=%d" % cfg["channels"], "--raw"]
    # ⚠️ 实测（Arch + PipeWire）：parec 不用 --latency-msec 时默认攒够 ~2 秒才吐数据，
    # 那 2 秒音频直接丢（按下就说话的桌面用法会吃掉整句话首）。加上小延迟即正常。
    lat = cfg.get("latency_ms", 50)
    if lat and int(lat) > 0:
        cmd.append("--latency-msec=%d" % int(lat))
    if cfg.get("source"):
        cmd.append("--device=%s" % cfg["source"])
    return cmd


def pcm_rms(data):
    """16bit PCM 的均方根 —— 用来粗判「有没有人在说话」。"""
    n = len(data) - (len(data) % 2)
    if n <= 0:
        return 0.0
    a = array.array("h")
    a.frombytes(data[:n])
    total = 0
    for v in a:
        total += v * v
    return math.sqrt(total / len(a))


class Recorder:
    """流式录音：后台线程读 parec，一边落盘一边算电平。

    这样桌面模式就能在「说过话之后静音」时自动收尾（连第二次按键都省了）。
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self.buf = bytearray()
        self.lock = threading.Lock()
        self.p = None
        self.f = None
        self.thread = None
        self.done = threading.Event()
        self.voiced = False
        self.voice_run = 0        # 连续超阈值的块数（偶发噪声/按键声不足以“武装”自动收尾）
        self.started = time.time()
        self.last_voice = self.started
        self.chunk = max(1, int(cfg["rate"] * 2 * cfg["channels"] * 0.1))  # 100ms

    def start(self):
        self.f = open(RAW_PATH, "wb")
        self.p = subprocess.Popen(recorder_cmd(self.cfg), stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, env=ENV or session_env())
        self.started = time.time()
        self.last_voice = self.started
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()
        return self

    def _loop(self):
        threshold = float(self.cfg.get("silence_rms", 300) or 0)
        need = max(1, int(self.cfg.get("voice_chunks", 3) or 1))
        while True:
            d = self.p.stdout.read(self.chunk)
            if not d:
                break
            with self.lock:
                self.buf += d
            try:
                self.f.write(d)
                self.f.flush()
            except Exception:
                pass
            if threshold > 0 and pcm_rms(d) >= threshold:
                self.last_voice = time.time()
                self.voice_run += 1
                if self.voice_run >= need:
                    self.voiced = True
            else:
                self.voice_run = 0
        self.done.set()

    def seconds(self):
        with self.lock:
            return len(self.buf) / float(self.cfg["rate"] * 2 * self.cfg["channels"])

    def silent_ms(self):
        return (time.time() - self.last_voice) * 1000.0

    def stop(self):
        """SIGINT 让 parec 把缓冲区刷干净，然后返回全部 PCM"""
        try:
            self.p.send_signal(signal.SIGINT)
            self.p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.p.kill(); self.p.wait()
        except Exception:
            pass
        if self.thread is not None:
            self.thread.join(timeout=2)
        try:
            self.f.close()
        except Exception:
            pass
        try:
            self.p.stdout.close()
        except Exception:
            pass
        with self.lock:
            raw = bytes(self.buf)
        if not raw:
            try:
                with open(RAW_PATH, "rb") as fp:
                    raw = fp.read()
            except Exception:
                raw = b""
        return raw

    def auto_stop_ready(self):
        """True = 该自动收尾了（说过话 + 静音够久 + 已录够长度）"""
        cfg = self.cfg
        if not cfg.get("auto_stop", True):
            return False
        if not self.voiced:
            return False
        wait = float(cfg.get("silence_ms", 1200) or 0)
        return self.silent_ms() >= wait and self.seconds() >= 0.8


def pcm_to_wav(raw, cfg):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(cfg["channels"])
        w.setsampwidth(2)
        w.setframerate(cfg["rate"])
        w.writeframes(raw)
    return buf.getvalue()


def pcm_to_opus(raw, cfg):
    """把裸 PCM 转成 OGG OPUS（体积约为 WAV 的 1/8），失败则回退 WAV。
       opus_bitrate<=0 或没装 opusenc 时直接返回 WAV。"""
    br = float(cfg.get("opus_bitrate", 24) or 0)
    if br > 0:
        try:
            r = subprocess.run(
                ["opusenc", "--quiet", "--raw",
                 "--raw-rate", str(cfg["rate"]),
                 "--raw-chan", str(cfg["channels"]),
                 "--raw-bits", "16",
                 "--bitrate", "%g" % br, "-", "-"],
                input=raw, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                env=ENV or session_env(), timeout=60)
            if r.returncode == 0 and r.stdout:
                return r.stdout
            log("opusenc 失败(rc=%s)，回退 WAV: %s"
                % (r.returncode, r.stderr.decode(errors="replace")[:120]))
        except FileNotFoundError:
            pass   # 没装 opusenc，静默回退 WAV
        except Exception as ex:
            log("opusenc 异常，回退 WAV: %s" % ex)
    return pcm_to_wav(raw, cfg)


# ───────────────────────── 识别 ─────────────────────────
ERRORS = {
    "20000000": "成功",
    "20000001": "识别中",
    "20000002": "识别中",
    "20000003": "音频是静音，没有检测到说话",
    "45000000": "请求头缺少 X-Api-Key",
    "45000010": "API Key 无效",
    "45000030": "该能力未开通（去豆包语音控制台『开通管理』开通）",
}


def transcribe(wav_bytes, cfg, retries=5):
    """返回 (ok, text_or_errmsg)"""
    b64 = base64.b64encode(wav_bytes).decode()
    body = json.dumps({
        "user": {"uid": cfg.get("uid") or "voicetype"},
        "audio": {"data": b64},
        "request": {"model_name": "bigmodel"},
    }).encode()

    last = "未知错误"
    for attempt in range(retries):
        req = urllib.request.Request(
            cfg["endpoint"], data=body,
            headers={
                "Content-Type": "application/json",
                "X-Api-Key": cfg["api_key"],
                "X-Api-Resource-Id": cfg["resource_id"],
                "X-Api-Request-Id": str(uuid.uuid4()),
                "X-Api-Sequence": "-1",
            })
        try:
            r = urllib.request.urlopen(req, timeout=90)
            code = r.headers.get("X-Api-Status-Code", "")
            raw = r.read().decode(errors="replace")
        except urllib.error.HTTPError as ex:
            code = ex.headers.get("X-Api-Status-Code", "") if ex.headers else ""
            raw = ex.read().decode(errors="replace")
            logid = ex.headers.get("X-Tt-Logid", "") if ex.headers else ""
            last = "%s %s (logid %s)" % (code, ERRORS.get(code, raw[:120]), logid)
            if code in ("45000010", "45000000", "45000030"):
                return False, last
        except Exception as ex:
            # 网络/域名解析临时故障（如 DNS EAI_AGAIN）→ 递增退避重试
            last = "网络异常: %s" % ex
            if attempt < retries - 1:
                wait = min(1.5 * (attempt + 1), 4)
                log("网络重试 %d/%d（%s），%.1fs 后再试" % (attempt + 1, retries, ex, wait))
                time.sleep(wait)
            continue

        if code == "20000000":
            try:
                text = (json.loads(raw).get("result") or {}).get("text", "") or ""
            except Exception:
                text = ""
            if not text.strip():
                return False, "识别结果为空"
            return True, text.strip()

        if code == "20000003":
            return False, "没听到说话（录音太短或全是静音）"

        last = "%s %s" % (code, ERRORS.get(code, raw[:120]))
        if attempt < retries - 1:
            time.sleep(0.8)

    return False, last


# ─────────────────── 剪贴板 + uinput 注入 ───────────────────
CLIP_TMP = "/dev/shm/voicetype_clip.txt"
CLIP_ERR = "/dev/shm/voicetype_clip.err"


def set_clipboard(text):
    """写入 Wayland 剪贴板。

    ⚠️ 关键：wl-copy 会 fork 一个【常驻】子进程来持有剪贴板，该子进程会继承
    父进程的 stdout/stderr。若用 subprocess 的 PIPE，父进程退出后管道仍不关闭，
    subprocess.communicate() 会一直等 EOF —— 表现为「卡住直到超时」。
    所以这里 stdio 全部重定向到文件 / DEVNULL，不给它任何管道。
    """
    try:
        with open(CLIP_TMP, "w", encoding="utf-8") as f:
            f.write(text)
        with open(CLIP_TMP, "rb") as fin, open(CLIP_ERR, "wb") as ferr:
            p = subprocess.run(
                ["wl-copy", "--type", "text/plain;charset=utf-8"],
                stdin=fin, stdout=subprocess.DEVNULL, stderr=ferr,
                env=ENV or session_env(), timeout=5)
        if p.returncode != 0:
            try:
                msg = open(CLIP_ERR, "rb").read().decode(errors="replace")[:200]
            except Exception:
                msg = ""
            log("wl-copy rc=%s err=%s" % (p.returncode, msg))
            return False
        return True
    except subprocess.TimeoutExpired:
        log("wl-copy 超时")
        return False
    except Exception as ex:
        log("wl-copy 异常: %s" % ex)
        return False


def clipboard_read():
    """读回剪贴板，用于校验（wl-paste 不会 fork 常驻进程，可安全用 PIPE）"""
    try:
        with open(CLIP_ERR, "wb") as ferr:
            p = subprocess.run(["wl-paste", "--no-newline"],
                               stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=ferr,
                               env=ENV or session_env(), timeout=5)
        return p.stdout.decode("utf-8", "replace")
    except Exception:
        return None


