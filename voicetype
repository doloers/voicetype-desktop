# 一份标准键盘的按键集合。
# ⚠️ 实测（Arch + niri + libinput）：uinput 设备光声明几个键（哪怕 ESC/ENTER/字母）
#    都拿不到 udev 的 ID_INPUT_KEYBOARD=1 标签，libinput 就不把它当键盘、
#    注入的按键会被静静丢掉；声明整套标准键位才会被当成键盘。
_KEYBOARD_KEYS = ("ESC 1 2 3 4 5 6 7 8 9 0 MINUS EQUAL BACKSPACE TAB "
                  "Q W E R T Y U I O P LEFTBRACE RIGHTBRACE ENTER LEFTCTRL "
                  "A S D F G H J K L SEMICOLON APOSTROPHE GRAVE LEFTSHIFT "
                  "BACKSLASH Z X C V B N M COMMA DOT SLASH RIGHTSHIFT KPENTER "
                  "LEFTALT RIGHTALT SPACE CAPSLOCK F1 F2 F3 F4 F5 F6 F7 F8 F9 "
                  "F10 F11 F12 LEFTMETA RIGHTMETA").split()


class Injector:
    """把按键组合送进当前焦点窗口（剪贴板已经在前面写好了）"""

    def paste(self, mods):
        raise NotImplementedError

    def enter(self):
        raise NotImplementedError

    def forward(self, code, value):
        """只有 uinput 独占模式需要：把非触发键透传回系统"""

    def close(self):
        pass


class UinputInjector(Injector):
    """虚拟键盘（/dev/uinput）—— 手机默认；需要 root 或 udev 授权"""

    def __init__(self, cfg):
        from evdev import ecodes as e, UInput
        self.cfg = cfg
        self.e = e
        keys = set()
        for name in _KEYBOARD_KEYS:                 # 先声明整套标准键位（见常量注释）
            code = getattr(e, "KEY_" + name, None)
            if code is not None:
                keys.add(code)
        for group in ("paste_mods", "paste_mods_terminal"):
            for m in (cfg.get(group) or []):
                keys.add(getattr(e, "KEY_" + m))
        keys.add(getattr(e, "KEY_" + cfg["paste_key"]))
        keys.add(e.KEY_ENTER)
        keys.add(e.KEY_VOLUMEUP)
        keys.add(e.KEY_VOLUMEDOWN)
        self.ui = UInput({e.EV_KEY: sorted(keys)},
                         name="voicetype-vkbd", bustype=e.BUS_USB)
        time.sleep(0.35)          # 等合成器识别到新设备

    def device_path(self):
        try:
            return self.ui.device.path if self.ui.device else "?"
        except Exception:
            return "?"

    def paste(self, mods):
        e, ui = self.e, self.ui
        mods = [getattr(e, "KEY_" + m) for m in mods]
        key = getattr(e, "KEY_" + self.cfg["paste_key"])
        for m in mods:
            ui.write(e.EV_KEY, m, 1)
        ui.syn()
        ui.write(e.EV_KEY, key, 1)
        ui.syn()
        time.sleep(0.02)
        ui.write(e.EV_KEY, key, 0)
        ui.syn()
        for m in reversed(mods):
            ui.write(e.EV_KEY, m, 0)
        ui.syn()

    def enter(self):
        """注入一次回车键 (tap Enter)"""
        e, ui = self.e, self.ui
        ui.write(e.EV_KEY, e.KEY_ENTER, 1)
        ui.syn()
        time.sleep(0.02)
        ui.write(e.EV_KEY, e.KEY_ENTER, 0)
        ui.syn()

    def forward(self, code, value):
        self.ui.write(self.e.EV_KEY, code, value)
        self.ui.syn()

    def close(self):
        try:
            self.ui.close()
        except Exception:
            pass


class WtypeInjector(Injector):
    """zwp_virtual_keyboard（wtype）—— 桌面推荐，无需 root/udev。
    只用来敲组合键；文本走剪贴板，所以中文/emoji 不受影响。"""

    def __init__(self, cfg):
        self.cfg = cfg

    def _run(self, args):
        try:
            r = subprocess.run(["wtype"] + args, stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                               env=ENV or session_env(), timeout=10)
            if r.returncode != 0:
                log("wtype rc=%s err=%s" % (r.returncode,
                                            r.stderr.decode(errors="replace").strip()[:160]))
            return r.returncode == 0
        except FileNotFoundError:
            log("❌ 没装 wtype（pacman -S wtype）")
            return False
        except Exception as ex:
            log("wtype 异常: %s" % ex)
            return False

    def paste(self, mods):
        # wtype 的参数：-M/-m 按下/松开修饰键，-s 插一段睡眠(ms)，-k 按一下某个 keysym
        #   （注意 -s 收的是整数毫秒，atoi 解析，写 0.03 会被当 0 而报错）
        hold = int(float(self.cfg.get("wtype_delay_ms", 30) or 0))
        args = []
        for m in mods:
            args += ["-M", _WTYPE_MODS.get(m.upper(), "ctrl")]
        if hold > 0:
            args += ["-s", str(hold)]
        args += ["-k", self.cfg["paste_key"].lower()]
        if hold > 0:
            args += ["-s", str(hold)]
        for m in reversed(mods):
            args += ["-m", _WTYPE_MODS.get(m.upper(), "ctrl")]
        return self._run(args)

    def enter(self):
        return self._run(["-k", "Return"])


def make_injector(cfg):
    kind = (cfg.get("injector") or "uinput").lower()
    if kind == "wtype":
        return WtypeInjector(cfg)
    if kind == "uinput":
        return UinputInjector(cfg)
    raise SystemExit("❌ 未知 injector: %s（可选 uinput / wtype）" % kind)


# ─────────────────── 焦点应用检测 ───────────────────
def focused_app(cfg):
    """查当前获得键盘焦点的顶层窗口 app_id，失败返回 None
    （上层会退回默认粘贴组合键）。

    focus_helper:
      niri = 用 `niri msg --json focused-window`（桌面推荐，无需额外小工具）
      其它  = 当作可执行文件名调用，取其 stdout（手机上的 wt-focus）
    """
    helper = cfg.get("focus_helper") or "wt-focus"
    env = ENV or session_env()
    if helper in ("niri", "niri-msg"):
        try:
            p = subprocess.run(["niri", "msg", "--json", "focused-window"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, env=env, timeout=3)
            if p.returncode == 0:
                win = json.loads(p.stdout.decode(errors="replace")) or {}
                return win.get("app_id") or None
        except Exception as ex:
            log("niri focused-window 失败: %s" % ex)
        return None
    path = shutil.which(helper) or os.path.expanduser("~/.local/bin/" + helper)
    if not os.path.exists(path):
        return None
    try:
        p = subprocess.run([path], stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           env=ENV or session_env(), timeout=3)
        if p.returncode == 0:
            return p.stdout.decode(errors="replace").strip() or None
    except Exception as ex:
        log("wt-focus 失败: %s" % ex)
    return None


# ─────────────────────── 麦克风自愈 ───────────────────────
# 自愈后是否处于「suspend-on-idle 已被卸载」的状态，以及最近一次录音时间。
# 用于空闲一段时间后自动把 suspend-on-idle 装回去，恢复省电。
_healed = False
_last_activity = 0.0


def reload_suspend(cfg):
    """空闲后把 suspend-on-idle 装回去，恢复省电。"""
    global _healed
    if not _healed:
        return
    env = ENV or session_env()
    try:
        subprocess.run(["pactl", "load-module", "module-suspend-on-idle"],
                       env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
        log("空闲 %ds 无录音，已重新启用 suspend-on-idle（恢复省电）"
            % cfg.get("suspend_reload_idle", 900))
    except Exception as ex:
        log("重新启用 suspend-on-idle 失败: %s" % ex)
    _healed = False


def heal_mic(cfg):
    """麦克风采集失效（suspend→resume 坏）时的自愈：
       重启 PulseAudio 重新初始化采集路径，再卸载 module-suspend-on-idle。
       （顺序很重要：必须在重启「之后」卸载，否则新实例会从
       /etc/pulse/default.pa 把它又装回来。）"""
    global _healed, _last_activity
    env = ENV or session_env()
    log("自愈：重启 PulseAudio 并卸载 suspend-on-idle")
    try:
        subprocess.run(["pulseaudio", "-k"], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except Exception as ex:
        log("自愈: pulseaudio -k 失败: %s" % ex)
    time.sleep(1.5)
    try:
        subprocess.run(["pactl", "info"], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except Exception as ex:
        log("自愈: 重新拉起 PulseAudio 失败: %s" % ex)
    try:
        subprocess.run(["pactl", "unload-module", "module-suspend-on-idle"],
                       env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except Exception as ex:
        log("自愈: 卸载 suspend-on-idle 失败: %s" % ex)
    _healed = True
    _last_activity = time.time()


# ─────────────────────── 录→识→贴 主流程 ───────────────────────
def do_transcribe_and_paste(cfg, inj, raw, secs=None):
    global _last_activity
    _last_activity = time.time()
    if secs is None:
        secs = len(raw) / float(cfg["rate"] * 2 * cfg["channels"])
    if secs < cfg.get("min_seconds", 0.4):
        log("录音过短 (%.2fs)，忽略" % secs)
        notify("录音太短", "多说一会儿再松手", icon="dialog-warning", timeout=2500)
        return

    # 纯静音（全 0）= 采集路径失效（手机的 suspend→resume 坏）→ 自愈后提示重说
    if raw and raw.count(0) == len(raw):
        log("检测到纯静音（采集路径失效）")
        if cfg.get("heal_mic", False):
            heal_mic(cfg)
            notify("麦克风已修复", "刚才没录到声音，请再说一次",
                   icon="microphone", timeout=5000, urgency="critical")
        else:
            notify("没录到声音", "麦克风采集是纯静音，检查一下输入设备",
                   icon="dialog-warning", timeout=4000, urgency="critical")
        return

    notify("识别中…", "%.1f 秒音频" % secs, icon="emblem-synchronizing", timeout=0)
    audio = pcm_to_opus(raw, cfg)
    if len(raw):
        log("音频压缩: PCM %d → 上传 %d 字节 (%.0f%%)"
            % (len(raw), len(audio), len(audio) * 100.0 / len(raw)))
    t0 = time.time()
    ok, res = transcribe(audio, cfg)
    dt = time.time() - t0

    if not ok:
        log("识别失败: %s" % res)
        notify("识别失败", res, icon="dialog-error", timeout=5000, urgency="critical")
        return

    log("识别成功 (%.2fs): %s" % (dt, res))
    if cfg.get("save_history", True):
        try:
            DATA_DIR.mkdir(parents=True, exist_ok=True)
            with open(HISTORY, "a") as f:
                f.write("%s\t%.1fs\t%s\n" % (
                    datetime.now().strftime("%Y-%m-%d %H:%M:%S"), secs, res))
        except Exception:
            pass

    if not set_clipboard(res):
        notify("已识别，但写剪贴板失败", res[:60], icon="dialog-warning", timeout=5000)
        return

    got = clipboard_read()
    if got is not None and got != res:
        log("⚠️ 剪贴板校验不一致: %r != %r" % (got[:40], res[:40]))

    app = focused_app(cfg)
    mods = cfg["paste_mods"]
    terms = [t.lower() for t in (cfg.get("terminal_apps") or [])]
    if app and app.lower() in terms:
        mods = cfg.get("paste_mods_terminal") or mods
        log("焦点应用 '%s' 是终端 -> %s" % (app, "+".join(mods)))
    else:
        log("焦点应用 '%s' -> %s" % (app or "未知", "+".join(mods)))

    time.sleep(0.2)          # 等剪贴板所有权生效
    inj.paste(mods)
    notify("已上屏", res[:60] + ("…" if len(res) > 60 else ""),
           icon="emblem-ok-symbolic", timeout=2500)


# ───────────────────────── 守护进程 ─────────────────────────
def find_device(name_sub):
    from evdev import InputDevice, list_devices
    for p in list_devices():
        try:
            d = InputDevice(p)
        except Exception:
            continue
        if name_sub.lower() in d.name.lower() and "voicetype" not in d.name.lower():
            return d
    return None


def run_daemon(cfg):
    from evdev import ecodes as e

    if not cfg.get("api_key"):
        log("❌ 未配置 api_key")
        notify("VoiceType 未配置", "请先在 config.json 填 api_key", icon="dialog-error")
        return 1

    dev = find_device(cfg["trigger_device"])
    if dev is None:
        log("❌ 找不到触发设备: %s" % cfg["trigger_device"])
        return 1
    log("触发设备: %s (%s)" % (dev.name, dev.path))

    inj = make_injector(cfg)
    log("注入方式: %s" % ("uinput 虚拟键盘 %s" % inj.ui.device.path
                          if isinstance(inj, UinputInjector) else "wtype"))

    grab = bool(cfg.get("grab", False))
    if grab:
        try:
            dev.grab()
            log("已独占 %s（音量键由本进程透传）" % dev.path)
        except Exception as ex:
            log("⚠️ grab 失败，退化为被动读取: %s" % ex)
            grab = False
    else:
        log("被动读取 %s —— 不影响其它读取者，音量键仍由系统处理" % dev.path)

    TRIG = getattr(e, cfg.get("trigger_key", "KEY_VOLUMEDOWN"))
    hold = cfg["hold_ms"] / 1000.0
    maxsec = cfg["max_seconds"]

    # 长按音量上 = 回车
    enter_enabled = bool(cfg.get("enter_enabled", True))
    ENTER_KEY = getattr(e, cfg.get("enter_key", "KEY_VOLUMEUP"))
    enter_hold = float(cfg.get("enter_hold_ms", cfg["hold_ms"])) / 1000.0

    press_t = None
    rec = None
    rec_t = None
    enter_press_t = None
    enter_fired = False
    handled_keys = (TRIG, ENTER_KEY) if enter_enabled else (TRIG,)

    def shutdown(sig, frame):
        log("收到信号 %s，退出" % sig)
        try:
            dev.ungrab()
        except Exception:
            pass
        inj.close()
        sys.exit(0)

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, shutdown)

    log("就绪：长按 %s (>=%dms) 说话，松开上屏" % (cfg.get("trigger_key"), cfg["hold_ms"]))
    if enter_enabled:
        log("      长按 %s (>=%dms) 注入回车" % (
            cfg.get("enter_key", "KEY_VOLUMEUP"),
            cfg.get("enter_hold_ms", cfg["hold_ms"])))
        notify("VoiceType 已就绪", "长按音量下说话；长按音量上回车",
               icon="microphone", timeout=2500)
    else:
        notify("VoiceType 已就绪", "长按音量下键说话", icon="microphone", timeout=2500)

    try:
        while True:
            r, _, _ = select.select([dev], [], [], 0.1)

            for ev in (dev.read() if r else []):
                if ev.type != e.EV_KEY:
                    continue

                # 独占模式下，非触发键要转发回系统（否则音量键失灵）
                if grab and ev.code not in handled_keys:
                    inj.forward(ev.code, ev.value)
                    continue

                # ── 长按音量上 = 回车 ──
                if enter_enabled and ev.code == ENTER_KEY:
                    if ev.value == 1:                       # 按下
                        if enter_press_t is None:
                            enter_press_t = time.time()
                            enter_fired = False
                    elif ev.value == 0:                     # 松开
                        if enter_press_t is not None:
                            held = (time.time() - enter_press_t) * 1000
                            enter_press_t = None
                            if not enter_fired:
                                log("短按音量上 %.0fms -> 忽略（音量正常调节）" % held)
                                if grab:
                                    inj.forward(ENTER_KEY, 1)
                                    time.sleep(0.03)
                                    inj.forward(ENTER_KEY, 0)
                            enter_fired = False
                    continue

                if ev.code != TRIG:
                    continue

                if ev.value == 1:                       # 按下
                    if rec is None and press_t is None:
                        press_t = time.time()

                elif ev.value == 0:                     # 松开
                    if rec is not None:
                        raw = rec.stop()
                        rec = None; rec_t = None; press_t = None
                        do_transcribe_and_paste(cfg, inj, raw)
                    elif press_t is not None:
                        held = (time.time() - press_t) * 1000
                        press_t = None
                        log("短按 %.0fms -> 忽略（音量正常调节）" % held)
                        if grab:
                            inj.forward(TRIG, 1)
                            time.sleep(0.03)
                            inj.forward(TRIG, 0)

            # 长按音量上 -> 回车
            if enter_enabled and enter_press_t is not None and not enter_fired:
                if time.time() - enter_press_t >= enter_hold:
                    enter_fired = True
                    log("长按音量上 -> 注入回车")
                    inj.enter()
                    notify("回车", "已发送 Enter", icon="emblem-ok-symbolic",
                           timeout=2000)

            # 长按判定
            if press_t is not None and rec is None:
                if time.time() - press_t >= hold:
                    log("长按触发 -> 开始录音")
                    notify("录音中…", "松开按钮结束", icon="microphone",
                           timeout=0, urgency="critical")
                    rec = Recorder(cfg).start()
                    rec_t = time.time()

            # 超长自动收尾
            if rec is not None and rec_t is not None and time.time() - rec_t >= maxsec:
                log("达到上限 %ds，自动结束" % maxsec)
                raw = rec.stop()
                rec = None; rec_t = None; press_t = None
                do_transcribe_and_paste(cfg, inj, raw)

            # 自愈后空闲过久 → 把 suspend-on-idle 装回去，恢复省电
            idle_reload = float(cfg.get("suspend_reload_idle", 900) or 0)
            if _healed and idle_reload > 0 and (time.time() - _last_activity) >= idle_reload:
                reload_suspend(cfg)
    finally:
        try:
            dev.ungrab()
        except Exception:
            pass
        inj.close()


# ─────────────────── 桌面模式：socket 服务 + 客户端 ───────────────────
def socket_path(cfg):
    p = (cfg.get("socket_path") or "").strip()
    if p:
        return os.path.expanduser(p)
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(runtime, "voicetype.sock")


class Server:
    """桌面守护进程：不碰 evdev，只等合成器快捷键通过 socket 下命令。

    命令: toggle / start / stop / enter / status / quit
    （toggle 可被连续调用，也支持「说完静音自动收尾」）
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self.rec = None
        self.inj = None
        self.path = socket_path(cfg)
        self.srv = None
        self.quit = False

    # ── 状态 / 动作 ──
    def state(self):
        return "recording" if self.rec is not None else "idle"

    def start_rec(self):
        if self.rec is not None:
            return False, "已经在录音了"
        if not self.cfg.get("api_key"):
            log("❌ 未配置 api_key，不能录音")
            notify("VoiceType 未配置", "请先在 ~/.config/voicetype/config.json 填 api_key",
                   icon="dialog-error", timeout=4000, urgency="critical")
            return False, "未配置 api_key"
        self.rec = Recorder(self.cfg).start()
        log("桌面：开始录音")
        notify("录音中…", "再按一次快捷键结束（停嘴稍等也会自动收尾）",
               icon="microphone", timeout=0, urgency="critical")
        return True, "recording"

    def stop_rec(self):
        if self.rec is None:
            return False, "没在录音"
        rec, self.rec = self.rec, None
        try:
            raw = rec.stop()
            secs = rec.seconds()
            log("桌面：停止录音 (%.1fs, %d 字节)" % (secs, len(raw)))
            do_transcribe_and_paste(self.cfg, self.inj, raw, secs)
        except Exception:
            log("💥 收尾失败:\n" + traceback.format_exc())
            notify("识别出错", "看 /tmp/voicetype.log", icon="dialog-error", timeout=4000)
        return True, "ok"

    def toggle(self):
        return self.stop_rec() if self.rec is not None else self.start_rec()

    def dispatch(self, cmd):
        if cmd == "toggle":
            return self.toggle()
        if cmd == "start":
            return self.start_rec()
        if cmd == "stop":
            return self.stop_rec()
        if cmd == "enter":
            self.inj.enter()
            notify("回车", "已发送 Enter", icon="emblem-ok-symbolic", timeout=2000)
            return True, "ok"
        if cmd == "status":
            return True, self.state()
        if cmd in ("quit", "exit"):
            self.quit = True
            return True, "bye"
        return False, "未知命令: %s" % cmd

    # ── 主循环 ──
    def tick(self):
        """没命令时也要跑的周期检查：静音自动收尾 / 超长收尾"""
        if self.rec is None:
            return
        if self.rec.auto_stop_ready():
            log("桌面：说话后静音 %.0fms，自动收尾" % self.rec.silent_ms())
            self.stop_rec()
        elif self.rec.seconds() >= float(self.cfg.get("max_seconds", 120) or 120):
            log("桌面：达到上限 %ss，自动收尾" % self.cfg.get("max_seconds"))
            self.stop_rec()

    def handle(self, conn):
        data = b""
        try:
            conn.settimeout(3)
            while b"\n" not in data and len(data) < 256:
                d = conn.recv(256)
                if not d:
                    break
                data += d
        except Exception:
            pass
        cmd = data.decode(errors="replace").strip().split("\n")[0].strip().lower()
        ok, msg = self.dispatch(cmd)
        try:
            conn.sendall((json.dumps({"ok": ok, "state": self.state(), "msg": msg}) + "\n")
                         .encode())
        except Exception:
            pass
        try:
            conn.close()
        except Exception:
            pass

    def run(self):
        self.inj = make_injector(self.cfg)
        if os.path.exists(self.path):
            try:
                os.unlink(self.path)
            except Exception:
                pass
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.srv.bind(self.path)
        os.chmod(self.path, 0o600)
        self.srv.listen(8)
        self.srv.settimeout(0.2)
        log("桌面模式就绪：socket %s（injector=%s）"
            % (self.path, self.cfg.get("injector", "uinput")))
        if not self.cfg.get("api_key"):
            log("❌ 还没配 api_key —— 服务照常跑，但录音会拒绝，先去填配置")
            notify("VoiceType 未配置", "先在 ~/.config/voicetype/config.json 填 api_key",
                   icon="dialog-error", timeout=0, urgency="critical")
        else:
            notify("VoiceType 已就绪", "按快捷键开始/结束语音输入",
                   icon="microphone", timeout=2500)
        try:
            while not self.quit:
                try:
                    conn, _ = self.srv.accept()
                except socket.timeout:
                    self.tick()
                    continue
                except Exception as ex:
                    log("accept 失败: %s" % ex)
                    time.sleep(0.2)
                    continue
                try:
                    self.handle(conn)
                except Exception:
                    log("💥 处理命令失败:\n" + traceback.format_exc())
        finally:
            if self.rec is not None:
                try:
                    self.rec.stop()
                except Exception:
                    pass
            self.inj.close()
            try:
                self.srv.close()
            except Exception:
                pass
            try:
                os.unlink(self.path)
            except Exception:
                pass
            log("桌面模式退出")
        return 0


def ctl(cfg, cmd, timeout=180.0):
    """客户端：把命令发给守护进程。没运行则顺手拉起 systemd 用户服务。"""
    path = socket_path(cfg)
    sock = None
    for attempt in (0, 1):
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect(path)
            break
        except Exception:
            try:
                sock.close()
            except Exception:
                pass
            sock = None
            if attempt == 0:
                log("守护进程没在跑，尝试拉起 voicetype.service")
                try:
                    subprocess.run(["systemctl", "--user", "start", "voicetype.service"],
                                   env=ENV or session_env(), timeout=15,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception as ex:
                    log("拉起服务失败: %s" % ex)
                time.sleep(1.5)
                continue
            log("❌ 连不上守护进程 (%s)" % path)
            notify("语音输入不可用", "守护进程没在跑：systemctl --user start voicetype",
                   icon="dialog-error", timeout=4000)
            return 1
    try:
        sock.sendall((cmd + "\n").encode())
        data = sock.recv(4096).decode(errors="replace").strip()
        log("ctl %s -> %s" % (cmd, data))
        return 0
    except Exception as ex:
        log("ctl %s 失败: %s" % (cmd, ex))
        return 1
    finally:
        try:
            sock.close()
        except Exception:
            pass


