def cmd_devices():
    from evdev import InputDevice, list_devices, ecodes as e
    print("输入设备：")
    for p in sorted(list_devices()):
        try:
            d = InputDevice(p)
            names = [e.KEY[k].decode() if isinstance(e.KEY[k], bytes) else str(k)
                     for k in d.capabilities().get(1, []) if k in e.KEY]
            print("  %-20s %-34s %s" % (p, d.name[:32], ",".join(names[:6])))
        except Exception as ex:
            print("  %-20s <读取失败 %s>" % (p, ex))
    return 0


def cmd_levels(cfg, secs):
    """录 N 秒只打印电平统计 —— 用来校准 silence_rms（安静跑一次、说话再跑一次）"""
    log("测电平 %.1f 秒…（先安静跑一次，再对着麦克风说话跑一次）" % secs)
    rec = Recorder(cfg).start()
    levels = []
    t0 = time.time()
    while time.time() - t0 < secs:
        time.sleep(0.1)
        with rec.lock:
            tail = bytes(rec.buf[-rec.chunk:])
        if tail:
            levels.append(pcm_rms(tail))
    rec.stop()
    if not levels:
        print("没采到数据（检查 parec/默认输入源）")
        return 1
    levels.sort()
    print("  窗口数 %d（每个 100ms）" % len(levels))
    print("  中位 RMS %d   90%% %d   最大 %d" % (
        levels[len(levels) // 2], levels[int(len(levels) * 0.9)], levels[-1]))
    print("  当前 silence_rms = %s（静音自动收尾的判定阈值）" % cfg.get("silence_rms"))
    print("  校准：安静时中位 RMS 要明显低于阈值（否则自动收尾失效）；")
    print("        说话时 90% 分位要明显高于阈值（否则刚开口就被当成静音）。")
    return 0


def cmd_record(cfg, secs):
    log("手动录音 %.1f 秒…" % secs)
    inj = make_injector(cfg)
    rec = Recorder(cfg).start()
    time.sleep(secs)
    raw = rec.stop()
    log("采集 %d 字节" % len(raw))
    do_transcribe_and_paste(cfg, inj, raw)
    inj.close()
    return 0


def cmd_check(cfg):
    ok = True
    kind = (cfg.get("injector") or "uinput").lower()
    print("── 配置 ──")
    print("  config      : %s %s" % (CONFIG_FILE, "✅" if CONFIG_FILE.exists() else "❌"))
    print("  api_key     : %s" % ("✅ 已设置 (%s…)" % cfg["api_key"][:8] if cfg["api_key"] else "❌ 未设置"))
    print("  resource_id : %s" % cfg["resource_id"])
    print("  injector    : %s" % kind)
    print("  触发        : 长按 %s >= %dms  (grab=%s)" % (cfg["trigger_key"], cfg["hold_ms"], cfg.get("grab")))
    print("  录音        : %dHz %dch  max %ss  自动收尾=%s(静音 %sms)" % (
        cfg["rate"], cfg["channels"], cfg.get("max_seconds"),
        "开" if cfg.get("auto_stop", True) else "关", cfg.get("silence_ms")))
    print("  enter       : 长按 %s >= %dms -> 回车 (%s)" % (
        cfg.get("enter_key", "KEY_VOLUMEUP"),
        cfg.get("enter_hold_ms", cfg["hold_ms"]),
        "开" if cfg.get("enter_enabled", True) else "关"))
    print("  paste       : %s + %s" % ("+".join(cfg["paste_mods"]) or "Ctrl", cfg["paste_key"]))
    print("  socket      : %s" % socket_path(cfg))

    print("── 依赖 ──")
    need_evdev = (kind == "uinput")
    try:
        import evdev  # noqa
        print("  python-evdev : ✅")
    except ImportError:
        print("  python-evdev : %s" % ("❌" if need_evdev else "– 不需要（injector=wtype）"))
        if need_evdev:
            ok = False
    bins = ["parec", "wl-copy", "notify-send"] + (["wtype"] if kind == "wtype" else [])
    for b in bins:
        rc = subprocess.run(["which", b], capture_output=True).returncode
        print("  %-12s : %s" % (b, "✅" if rc == 0 else "❌"))
        if rc != 0:
            ok = False
    if not shutil.which("opusenc"):
        print("  %-12s : ⚠️ 未装（将直接传 WAV）" % "opusenc")

    if need_evdev:
        print("── 设备 ──")
        desktop = (cfg.get("mode") or "phone").lower() == "desktop"
        d = find_device(cfg["trigger_device"])
        if d:
            print("  触发设备     : %s (%s) ✅" % (d.name, d.path))
        elif desktop:
            print("  触发设备     : ⚠️ 没找到 %s（桌面模式不需要，手机模式才用）" % cfg["trigger_device"])
        else:
            print("  触发设备     : ❌ %s" % cfg["trigger_device"])
            ok = False
        up = os.access("/dev/uinput", os.W_OK)
        print("  /dev/uinput  : %s" % ("✅ 可写" if up else "❌ 不可写（跑一次 setup-uinput-desktop.sh）"))
        if not up:
            ok = False

    print("── 会话 ──")
    env = session_env()
    for k in _SESSION_KEYS:
        print("  %-24s: %s" % (k, env.get(k, "❌ 缺失")))

    print("── 守护进程 ──")
    if kind == "wtype":
        sp = socket_path(cfg)
        live = False
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(3)
            s.connect(sp)
            s.sendall(b"status\n")
            live = b"idle" in s.recv(256) or b"recording" in s.recv(256)
            s.close()
        except Exception:
            live = False
        print("  socket 可连  : %s" % ("✅ 守护进程在跑" if live else "⚠️ 没在跑（systemctl --user start voicetype）"))

    print("── 剪贴板 ──")
    print("  wl-copy 写入 : %s" % ("✅" if set_clipboard("voicetype-check") else "❌"))

    print("── 焦点检测 ──")
    helper = cfg.get("focus_helper") or "wt-focus"
    if helper in ("niri", "niri-msg"):
        print("  %-12s : %s" % (helper, "✅ 内置（niri msg）" if shutil.which("niri") else "❌ 没找到 niri"))
    else:
        hp = shutil.which(helper) or os.path.expanduser("~/.local/bin/" + helper)
        print("  %-12s : %s" % (helper, ("✅ " + hp) if os.path.exists(hp)
                                     else "⚠️ 未找到（将固定用 Ctrl+V）"))
    fa = focused_app(cfg)
    print("  当前焦点应用 : %s" % (fa if fa else "（查不到）"))
    terms = [t.lower() for t in (cfg.get("terminal_apps") or [])]
    print("  将使用       : %s" % ("Ctrl+Shift+V（终端）" if (fa and fa.lower() in terms)
                                     else "Ctrl+V"))

    print("── API ──")
    raw = b"\0" * (cfg["rate"] * 2)
    okr, res = transcribe(pcm_to_wav(raw, cfg), cfg)
    print("  结果         : %s" % (("✅ " + res) if okr else "（静音为预期）" + res))
    return 0 if ok else 1


USAGE = """VoiceType — 长按音量键说话，松手自动上屏

  voicetype                启动守护进程（手机：长按音量键）
  voicetype --serve        启动桌面守护进程（socket 控制，给 niri 快捷键用）
  voicetype --toggle       开始 / 停止录音
  voicetype --start        只开始录音
  voicetype --stop         只停止录音（识别 + 上屏）
  voicetype --status       打印当前状态
  voicetype --enter        注入一次回车
  voicetype --record N     手动录 N 秒并粘贴（调试）
  voicetype --levels N     录 N 秒只打电平统计（校准 silence_rms）
  voicetype --devices      列出输入设备
  voicetype --check        自检
  voicetype --config       打印当前配置
"""


def main():
    global ENV
    ENV = session_env()
    args = sys.argv[1:]
    cfg = load_config()

    if not args:
        return run_daemon(cfg)
    a = args[0]
    if a in ("-h", "--help"):
        print(USAGE); return 0
    if a == "--devices":
        return cmd_devices()
    if a == "--check":
        return cmd_check(cfg)
    if a == "--config":
        print(json.dumps({**cfg,
                          "api_key": (cfg["api_key"][:8] + "…") if cfg["api_key"] else ""},
                         indent=2, ensure_ascii=False))
        return 0
    if a == "--serve":
        return Server(cfg).run()
    if a in ("--toggle", "--start", "--stop", "--status", "--enter"):
        return ctl(cfg, a[2:])
    if a == "--record":
        return cmd_record(cfg, float(args[1]) if len(args) > 1 else 5.0)
    if a == "--levels":
        return cmd_levels(cfg, float(args[1]) if len(args) > 1 else 5.0)
    print("未知参数: %s\n" % a)
    print(USAGE)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception:
        log("💥 未捕获异常:\n" + traceback.format_exc())
        sys.exit(1)
