def log(msg):
    line = "%s  %s" % (datetime.now().strftime("%H:%M:%S"), msg)
    try:
        print(line, flush=True)
    except Exception:
        pass
    try:
        with open(LOGFILE, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


# ─────────────────────── 会话环境发现 ───────────────────────
_SESSION_KEYS = ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                 "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_TYPE")

def session_env():
    """缺会话变量时，从同 uid 的图形会话进程里捞。让守护进程既能被
    systemd/autostart 启动，也能从 SSH 里手动跑。"""
    env = dict(os.environ)
    if env.get("WAYLAND_DISPLAY") and env.get("DBUS_SESSION_BUS_ADDRESS"):
        return env
    uid = os.getuid()
    for pdir in sorted(glob.glob("/proc/[0-9]*")):
        try:
            if os.stat(pdir).st_uid != uid:
                continue
            with open(pdir + "/environ", "rb") as f:
                items = f.read().split(b"\0")
        except Exception:
            continue
        found = {}
        for kv in items:
            if b"=" not in kv:
                continue
            k, v = kv.split(b"=", 1)
            k = k.decode(errors="replace")
            if k in _SESSION_KEYS:
                found[k] = v.decode(errors="replace")
        if found.get("WAYLAND_DISPLAY") and found.get("DBUS_SESSION_BUS_ADDRESS"):
            env.update(found)
            return env
    return env

