[Unit]
Description=VoiceType Desktop — 快捷键语音输入（socket 模式）（socket 模式，由合成器快捷键驱动）
Documentation=https://github.com/doloers/voicetype-desktop
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voicetype --serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
